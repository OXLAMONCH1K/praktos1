<Window x:Class="Prakt1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа №1. Вариант 5. Произведение чисел меньше 3"
        Height="380" Width="640" MinHeight="300" MinWidth="500">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть..." Click="Open_Click"/>
                <MenuItem Header="Сохранить..." Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Массив">
                <MenuItem Header="Заполнить" Click="Fill_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
                <Separator/>
                <MenuItem Header="Рассчитать" Click="Calc_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="5">
            <Button Content="О программе" Width="110" Margin="5" Click="About_Click"/>
            <Button Content="Выход" Width="110" Margin="5" Click="Exit_Click"/>
        </StackPanel>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Количество чисел n:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCount" Width="60" Margin="5,0,15,0" Text="10"/>
                <TextBlock Text="Диапазон ±:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtRange" Width="60" Margin="5,0,15,0" Text="10"/>
                <Button Content="Заполнить" Width="90" Margin="5,0" Click="Fill_Click"/>
                <Button Content="Очистить" Width="90" Margin="5,0" Click="Clear_Click"/>
                <Button Content="Рассчитать" Width="90" Margin="5,0" Click="Calc_Click"/>
            </StackPanel>

            <DataGrid x:Name="dataGrid" Grid.Row="1"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"/>

            <TextBlock x:Name="txtResult" Grid.Row="2" Margin="0,10,0,0"
                       FontSize="16" FontWeight="Bold"
                       Text="Результат: "/>
        </Grid>
    </DockPanel>
</Window>